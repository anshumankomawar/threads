{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["electron-vite/node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "convex", "tests", "*.config.*"]
}
