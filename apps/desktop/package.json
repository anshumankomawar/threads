{
  "name": "desktop",
  "version": "1.0.0",
  "description": "The Threads desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "lint": "vp lint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "vp run typecheck:node && vp run typecheck:web",
    "start": "electron-vite preview",
    "dev": "while :; do electron-vite dev; [ $? -eq 75 ] || break; done",
    "build": "vp run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/name-electron.mjs",
    "build:unpack": "vp run build && electron-builder --dir",
    "build:win": "vp run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.17",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@solidjs/web": "2.0.0-rc.21",
    "@stylexjs/stylex": "0.19.1",
    "@tiptap/core": "3.32.0",
    "better-auth": "1.7.17",
    "conf": "^16.0.0",
    "minisearch": "7.2.0",
    "models": "workspace:*",
    "solid-js": "2.0.0-rc.21",
    "sync": "workspace:*"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@solidjs/vite-plugin": "3.0.0-next.56",
    "@stylexjs/unplugin": "0.19.1",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
